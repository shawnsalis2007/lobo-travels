PORT=5000

# Google Gemini Flash API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Credentials (Option 1: Path to downloaded JSON key)
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Firebase Admin Credentials (Option 2: Direct environment variables)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
